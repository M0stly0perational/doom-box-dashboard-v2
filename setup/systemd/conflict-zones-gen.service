[Unit]
Description=Conflict zone polygon + battle-line generator from GDELT cache
After=network.target

[Service]
Type=oneshot
User=doombox
ExecStart=/usr/bin/python3 %h/conflict-zones-gen/gen.py
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.node-red/static/dashboard/data/intel
NoNewPrivileges=true
