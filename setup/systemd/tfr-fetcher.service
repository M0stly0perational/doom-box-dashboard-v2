[Unit]
Description=FAA TFR (Temporary Flight Restriction) fetcher for DOOM BOX dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=doombox
ExecStart=/usr/bin/python3 %h/tfr-fetcher/fetch.py
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.node-red/static/dashboard/data/intel %h/tfr-fetcher
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
