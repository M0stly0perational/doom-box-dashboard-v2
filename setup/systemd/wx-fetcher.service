[Unit]
Description=OFFGRID-BASE wx-fetcher (NWS active alerts + observations + forecast)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=doombox
Group=doombox
WorkingDirectory=%h/wx-fetcher
ExecStart=%h/wx-fetcher/.venv/bin/python %h/wx-fetcher/fetch.py
TimeoutStartSec=120
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.node-red/static/dashboard/data/wx %h/wx-fetcher
PrivateTmp=true
NoNewPrivileges=true
