[Unit]
Description=Fetch LVMPD open crime data
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=doombox
Group=doombox
ExecStart=/home/doombox/crime-fetcher/.venv/bin/python /home/doombox/crime-fetcher/fetch.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900
