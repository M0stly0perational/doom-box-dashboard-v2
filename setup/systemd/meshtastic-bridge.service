[Unit]
Description=Meshtastic <-> FTS bridge + dashboard data source
After=network.target freetakserver.service
Wants=freetakserver.service

[Service]
Type=simple
User=doombox
Group=doombox
RuntimeDirectory=meshtastic
RuntimeDirectoryMode=0755
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/meshtastic-bridge-venv/bin/python3 %h/meshtastic-bridge/bridge.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
