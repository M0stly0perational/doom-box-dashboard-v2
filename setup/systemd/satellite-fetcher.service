[Unit]
Description=Satellite pass predictor for DOOM BOX dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=doombox
ExecStart=%h/satellite-fetcher/.venv/bin/python3 %h/satellite-fetcher/fetch.py
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.node-red/static/dashboard/data/intel %h/satellite-fetcher
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
