[Unit]
Description=ACLED conflict events fetcher for DOOM BOX dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=doombox
ExecStart=/usr/bin/python3 /home/doombox/acled-fetcher/fetch.py
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/doombox/.node-red/static/dashboard/data/intel /home/doombox/acled-fetcher /home/doombox/.node-red
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
