[Unit]
Description=ACLED conflict events fetcher for DOOM BOX dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=doombox
ExecStart=/usr/bin/python3 %h/acled-fetcher/fetch.py
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.node-red/static/dashboard/data/intel %h/acled-fetcher %h/.node-red
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
