[Unit]
Description=OFFGRID-BASE POI fetcher (OSM Overpass + FEMA NFHL)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=doombox
Group=doombox
WorkingDirectory=%h/poi-fetcher
ExecStart=%h/poi-fetcher/.venv/bin/python %h/poi-fetcher/fetch.py
TimeoutStartSec=900
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.node-red/static/dashboard/data/poi %h/poi-fetcher
PrivateTmp=true
NoNewPrivileges=true
